# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=quizisdb
POSTGRES_USER=quizuser
POSTGRES_PASSWORD=quizpass
POSTGRES_PORT=5434

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
# DATABASE_URL para uso local (Prisma fuera de Docker)
DATABASE_URL=postgresql://quizuser:quizpass@localhost:5434/quizisdb
