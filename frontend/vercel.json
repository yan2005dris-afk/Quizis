{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "framework": "angular",

  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",

  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quizis-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "github": {
    "silent": true
  }
}