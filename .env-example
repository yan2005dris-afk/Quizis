# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=generate_a_strong_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_strong_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
JWT_ROOM_SECRET=generate_a_strong_secret_for_room_invitation_tokens
JWT_ROOM_EXPIRES_IN=1h

# ─── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/your_db_name

# ─── Cache / Redis (Upstash) ──────────────────────
# Reemplazar con tu URL de Upstash (usar rediss:// para TLS)
REDIS_URL=rediss://default:your_password@your_endpoint.upstash.io:6379

OPENAI_API_KEY=tu_api_key

# ═══════════════════════════════════════════════
# ESTRUCTURA PARA .env.test  (integration/e2e tests)
# Crea el archivo en: backend/.env.test
# ═══════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────
# POSTGRES_DB=quizis_test
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_PORT=5432

# ─── JWT ───────────────────────────────────────
# Secrets fijos y cortos — solo para entorno local de test
# JWT_ACCESS_SECRET=test-access-secret-quizis-integration
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=test-refresh-secret-quizis-integration
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_ROOM_SECRET=test-room-secret-quizis-integration
# JWT_ROOM_EXPIRES_IN=1h

# ─── CORS ──────────────────────────────────────
# CORS_ORIGIN=http://localhost:4200

# ─── Backend / Entorno ─────────────────────────
# NODE_ENV=test
# PORT=3001
# DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/quizis_test

# ─── Cache / Redis ─────────────────────────────
# Solo necesario para e2e completo (auth integration no requiere Redis)
# REDIS_URL=redis://localhost:6379

# ─── OpenAI ────────────────────────────────────
# OPENAI_API_KEY=test-openai-key
