# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=generate_a_strong_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_strong_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:4200

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
# DATABASE_URL para uso local (Prisma fuera de Docker)
DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/your_db_name

# ─── Cache / Redis (Upstash) ──────────────────────
# Reemplazar con tu URL de Upstash (usar rediss:// para TLS)
REDIS_URL=rediss://default:your_password@your_endpoint.upstash.io:6379

