# =============================================================================
# Quizis — Ejemplo de variables de entorno
# =============================================================================
# Copiar a .env y reemplazar los valores según corresponda.
# NUNCA commitear el .env real con secrets.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=quizisdb
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432

# ─── Backend ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/quizisdb

# ─── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate_a_strong_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate_a_strong_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
JWT_ROOM_SECRET=generate_a_strong_secret_for_room_invitation_tokens
JWT_ROOM_EXPIRES_IN=1h

# ─── CORS ────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma.
# En producción, agregar el dominio: https://quizis.dihm-muertos.site
CORS_ORIGIN=http://localhost:4200,http://localhost:80

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=tu_api_key

# ─── Cloudflare Tunnel (opcional, solo producción) ───────────────────────────
# Token del tunnel en Cloudflare Zero Trust.
# El Public Hostname debe apuntar a http://quizis-frontend:80
# TUNNEL_TOKEN=

# ─── Puertos host (opcional, solo producción) ────────────────────────────────
# Útil si en el servidor conviven varios proyectos.
# QUIZIS_FRONTEND_PORT=8082
# QUIZIS_BACKEND_PORT=3003
# QUIZIS_POSTGRES_PORT=5434
# QUIZIS_REDIS_PORT=6380

# ═══════════════════════════════════════════════════════════════════════════
# ENTORNO DE TESTS  (integration / e2e)
# ═══════════════════════════════════════════════════════════════════════════
# Crear backend/.env.test con estos valores.
# ⚠️  USAR UNA DB DEDICADA — los tests hacen INSERT/DELETE reales.
# ═══════════════════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# POSTGRES_DB=quizis_test
# POSTGRES_USER=your_db_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_PORT=5432

# ─── JWT ──────────────────────────────────────────────────────────────────
# JWT_ACCESS_SECRET=test-access-secret-quizis-integration
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=test-refresh-secret-quizis-integration
# JWT_REFRESH_EXPIRES_IN=7d
# JWT_ROOM_SECRET=test-room-secret-quizis-integration
# JWT_ROOM_EXPIRES_IN=1h

# ─── CORS ─────────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:4200

# ─── Backend ──────────────────────────────────────────────────────────────
# NODE_ENV=test
# PORT=3001
# DATABASE_URL=postgresql://your_db_user:your_secure_password@localhost:5432/quizis_test

# ─── Cache ────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── OpenAI ───────────────────────────────────────────────────────────────
# OPENAI_API_KEY=test-key
